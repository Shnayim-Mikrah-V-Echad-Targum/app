  "aiNoticeTitle": "Made with AI",
  "@aiNoticeTitle": {
    "description": "Heading of the notice that the app was made with AI, on Today, About and Texts & sources."
  },
  "aiNoticeBody": "This app, its website and its code were vibe-coded with AI (Claude). Its texts were built by scripts from the public sources named on Texts & sources. Before you rely on any verse, check it against its source, and tell us if anything differs.",
  "@aiNoticeBody": {
    "description": "The notice that the app was made with AI, with where its texts come from and how to check them."
  },
  "sourcesTopTitle": "Where each text comes from",
  "@sourcesTopTitle": {
    "description": "Heading above the explanation of how the app's texts are built from their sources."
  },
  "sourcesTopBody": "Each text is built from one named public edition, which you can open and compare with the app. The build can be repeated: a checksum (SHA-256) of every source file, and of every file the app ships, is listed in SOURCES.json, so anyone can check them.",
  "@sourcesTopBody": {
    "description": "How the texts are built and how to check them: the editions, the repeatable build and the checksums."
  },
  "sourcesTorahDifferences": "In the Torah, the text follows the Ashkenazi and Sephardi scrolls wherever they differ from the Aleppo Codex, which the Wikisource edition gives. Each such place is marked in the text, with the Codex’s reading in a note. So a comparison with the Codex shows those differences on purpose.",
  "@sourcesTorahDifferences": {
    "description": "Why a Torah text may differ from the Aleppo Codex edition on Wikisource, and that it does so on purpose."
  },
  "sourcesManifestAction": "Checksums of every file",
  "@sourcesManifestAction": {
    "description": "The name of the card that opens SOURCES.json, the list of checksums."
  },
  "sourcesManifestDescription": "SOURCES.json lists each source file with its Sefaria address and SHA-256, and each file the app ships with its SHA-256. Download a source, hash it, and compare.",
  "@sourcesManifestDescription": {
    "description": "What SOURCES.json holds and how to use it to check a file."
  },
