<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: paper with a hairline, as the app's cards
     (docs/DESIGN_SYSTEM.md §6.30). Android 12 and later round it as the
     launcher rounds widgets (drawable-v31). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <stroke android:width="1dp" android:color="@color/widget_hairline" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
