<?xml version="1.0" encoding="utf-8"?>
<!-- The bar of the second reading on the ring track, in its ring's colour. The
     progress is scaled rather than clipped, so its end stays round. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/widget_mikra2" />
            </shape>
        </scale>
    </item>
</layer-list>
